# secrets (copy .env.example to .env and fill it in)
.env
# everything the pipeline generates (kit/paths.py): output/final (deliverables), output/jobs (takes), output/temp
output/
# takes made before 2026-10-07 (old one-folder layout) stay on the machine that made them
jobs/
# models and compiled tools: `./setup.sh` (or `uv run shorts setup`) downloads and builds them
kit/models/*.bin
kit/models/*.onnx
kit/models/*.json
kit/models/hf/
kit/bin/
# python
.venv/
__pycache__/
*.pyc
.pytest_cache/
# node
node_modules/
# macOS
.DS_Store
# graphics library caches: the preview stills are tracked (Claude reads them when choosing templates); videos rebuild
kit/graphics/_previews/*
!kit/graphics/_previews/*.png
kit/graphics/_sample/
# audio library: the mp3/wav files ARE tracked (some tracks can't be re-downloaded); only download candidates stay out
kit/assets_src/cand/
# films: sources and renders stay local
films/**/*.wav
films/**/*.mp4
films/**/*.npy
films/**/*.log
films/**/parts_*/
films/**/out/
films/**/frames/
films/**/node_modules/
films/**/renders/
films/**/*.webm
films/**/work/
# films: build outputs (build.py inlines the kit into index.html and copies gsap + fonts via kit/hf/vendor.py)
films/**/vendor/
films/expensewaale/index.html
films/expensewaale/reel/index.html
films/expensewaale/assets/fonts/
films/expensewaale/reel/assets/fonts/
films/how-i-edit/index.html
films/how-i-edit/reel/index.html
# QA review sheets are regenerated by kit/qa/sheet.py (ledgers stay tracked)
films/**/review/**/*.jpg
# version 7 demos and evaluations: media stays local
kit/hf/demos/**/work/
kit/hf/demos/**/renders/
kit/hf/demos/**/node_modules/
kit/hf/demos/**/*.mp4
kit/hf/demos/**/*.webm
kit/hf/demos/**/*.wav
kit/*/eval/

# audio downloaded by setup.sh (kit/assets_src/fetch.py): the licences don't allow committing it
kit/music/**/*.mp3
kit/sfx/**/*.wav

{
  "registry": "kit/hf",
  "version": "1.0.0",
  "notes": "Long-form (HyperFrames) scene components. Every entry is deterministic and seekable (state is a pure function of time). 'explains' uses the types in kit/refs/SCENES.md; 'timing' is seconds on screen; previews come from kit/hf/showcase (python3 build.py --previews). Short-form templates live in kit/graphics/<id>/meta.json with the same fields.",
  "components": {
    "camera": { "version": "1.0.0", "file": "scenes.js", "call": "HF.camera(K, st, { framing })", "explains": ["structure"],
      "inputs": { "required": ["pieces[].face (from kit/look/grade.py track)", "framing: tag -> W|M|C|SR|SL|PIP|OFF"], "optional": ["scales", "pip", "mode: 'panel' (9:16)", "hideAt"] },
      "timing": { "min": 0, "max": null }, "ratios": ["16:9", "9:16"], "assets": ["the graded A-roll video"], "fallback": null, "preview": "previews/camera_side.jpg" },
    "words": { "version": "1.0.0", "file": "core.js", "call": "K.rise(K.words(layer, 'Big *idea', style).ws, [t])", "explains": ["definition", "emphasis"],
      "inputs": { "required": ["text (| = new line, * = accent italic word)"], "optional": ["style"] },
      "timing": { "min": 1.5, "ideal": 3, "max": 6 }, "ratios": ["16:9", "9:16"], "assets": [], "fallback": "pill", "preview": "previews/camera_side.jpg",
      "rule": "restrained: a few words that name the idea, never the whole sentence" },
    "side": { "version": "1.0.0", "file": "scenes.js", "call": "HF.side(K, st, a, b)", "explains": ["definition", "emphasis", "proof", "conversation"],
      "inputs": { "required": ["a", "b"], "optional": [] }, "timing": { "min": 1.5, "ideal": 4, "max": 10 }, "ratios": ["16:9"], "assets": [], "fallback": null,
      "preview": "previews/camera_side.jpg", "rule": "content column x 110-830 with framing SR, or 1150-1830 with SL" },
    "insert": { "version": "1.0.0", "file": "scenes.js", "call": "HF.insert(K, st, a, b, { keep, dark })", "explains": ["structure"],
      "inputs": { "required": ["a", "b"], "optional": ["keep", "dark", "sfx"] }, "timing": { "min": 2, "ideal": 6, "max": 15 }, "ratios": ["16:9", "9:16"], "assets": [], "fallback": "side", "preview": "previews/diagram.jpg" },
    "card": { "version": "1.0.0", "file": "scenes.js", "call": "HF.card(K, layer, x, y, w, h, html)", "explains": ["definition", "proof"], "inputs": { "required": ["x", "y", "w"], "optional": ["h", "html"] },
      "timing": { "min": 1.5, "ideal": 3, "max": 8 }, "ratios": ["16:9", "9:16"], "assets": [], "fallback": "pill", "preview": "previews/screen.jpg" },
    "pill": { "version": "1.0.0", "file": "scenes.js", "call": "HF.pill(K, layer, x, y, html)", "explains": ["emphasis", "structure"], "inputs": { "required": ["x", "y", "html"], "optional": [] },
      "timing": { "min": 1, "ideal": 2, "max": 6 }, "ratios": ["16:9", "9:16"], "assets": [], "fallback": null, "preview": "previews/camera_side.jpg" },
    "win": { "version": "1.0.0", "file": "scenes.js", "call": "HF.win(K, layer, x, y, w, h, url, img) + HF.scroll(K, win, y0, y1, t, dur)", "explains": ["proof", "instruction"],
      "inputs": { "required": ["url", "img (a light-mode capture: films/how-i-edit/capture.mjs)"], "optional": ["dark"] }, "timing": { "min": 2, "ideal": 5, "max": 12 },
      "ratios": ["16:9", "9:16"], "assets": ["screenshot (tall for scrolling)"], "fallback": "card", "preview": "previews/screen.jpg" },
    "phone": { "version": "1.0.0", "file": "scenes.js", "call": "HF.phone(K, layer, src, cx, cy, h, start, dur, media, rot)", "explains": ["proof"], "inputs": { "required": ["src (9:16 mp4)"], "optional": ["rot"] },
      "timing": { "min": 2, "ideal": 4, "max": 10 }, "ratios": ["16:9", "9:16"], "assets": ["vertical B-roll"], "fallback": "win", "preview": null },
    "lowerThird": { "version": "1.0.0", "file": "scenes.js", "call": "HF.lowerThird(K, st.top, { name, line, t })", "explains": ["structure"], "inputs": { "required": ["name", "t"], "optional": ["line", "hold", "x", "y"] },
      "timing": { "min": 3, "ideal": 4.2, "max": 6 }, "ratios": ["16:9", "9:16"], "assets": [], "fallback": null, "preview": "previews/lowerThird.jpg", "rule": "once, in the first 2 s, on the speaker" },
    "chapter": { "version": "1.0.0", "file": "scenes.js", "call": "HF.chapter(K, st.top, a, b, num, name)", "explains": ["structure"], "inputs": { "required": ["a", "b", "name"], "optional": ["num"] },
      "timing": { "min": 5, "ideal": 20, "max": null }, "ratios": ["16:9", "9:16"], "assets": [], "fallback": null, "preview": "previews/diagram.jpg" },
    "compare": { "version": "1.0.0", "file": "scenes.js", "call": "HF.compare(K, layer, { left, right, t, verdict })", "explains": ["comparison"],
      "inputs": { "required": ["left {title, rows[]}", "right {title, rows[]}", "t"], "optional": ["tone", "rowsAt[]", "verdict {side, t}", "x", "y", "w"] },
      "timing": { "min": 3, "ideal": 5, "max": 10 }, "ratios": ["16:9"], "assets": [], "fallback": "side", "preview": "previews/compare.jpg", "rule": "rows align: row k on the left answers row k on the right" },
    "chat": { "version": "1.0.0", "file": "scenes.js", "call": "HF.chat(K, layer, { msgs, thinking })", "explains": ["conversation", "instruction"],
      "inputs": { "required": ["msgs [{from: you|ai, text, t, cps?}]"], "optional": ["title (generic, no brand logo)", "thinking [t0, t1]", "x", "y", "w", "h"] },
      "timing": { "min": 3, "ideal": 5, "max": 10 }, "ratios": ["16:9", "9:16"], "assets": [], "fallback": "card", "preview": "previews/chat.jpg" },
    "endCard": { "version": "1.0.0", "file": "scenes.js", "call": "HF.endCard(K, st.full, { t, title, sub, cta, handle })", "explains": ["ask"], "inputs": { "required": ["t"], "optional": ["title", "sub", "cta", "handle"] },
      "timing": { "min": 2.5, "ideal": 3.5, "max": 6 }, "ratios": ["16:9", "9:16"], "assets": [], "fallback": null, "preview": "previews/endCard.jpg" },
    "diagram": { "version": "1.0.0", "file": "diagram.js", "call": "HF.diagram(K, layer, { nodes, edges, layout, shape }) then .show/.reveal/.connect/.focus/.overview/.flow/.done/.note/.highlight",
      "explains": ["process", "relationship", "mechanism", "structure"],
      "inputs": { "required": ["nodes [{id, label, sub?, icon?, x?, y?}]"], "optional": ["edges [[from, to, curve?]]", "layout row|column|grid", "shape circle|card", "title", "steps:false"] },
      "timing": { "min": 3, "ideal": 8, "max": 30 }, "ratios": ["16:9", "9:16 (layout column)"], "assets": [], "fallback": "flow_steps (shorts) / side words",
      "preview": "previews/diagram_focus.jpg", "rule": "one diagram per idea that develops across passages: show() it again later instead of redrawing; focus the step being talked about" },
    "screen": { "version": "1.0.0", "file": "screen.js", "call": "HF.screen(K, layer, { src|img, srcW, srcH, ... }) then .zoom/.reset/.pan/.highlight/.arrow/.cursor/.callout/.blur",
      "explains": ["instruction", "proof"],
      "inputs": { "required": ["src (screen recording mp4) or img", "srcW", "srcH"], "optional": ["chrome browser|window|none", "url", "start", "dur", "mediaStart", "fit width|contain"] },
      "timing": { "min": 4, "ideal": 10, "max": 40 }, "ratios": ["16:9", "9:16 (zoomed crops)"], "assets": ["a screen recording (OBS / QuickTime) or a screenshot"],
      "fallback": "win", "preview": "previews/screen.jpg",
      "rule": "coordinates in source pixels from kit/hf/tools/locate.py or grid.py; annotate only while the screen is still; blur anything private" },
    "code": { "version": "1.0.0", "file": "code.js", "call": "HF.code(K, layer, { lines, lang, title }) then .show/.typeIn/.highlight/.focus/.add/.remove/.scrollTo",
      "explains": ["code", "instruction", "mechanism"], "inputs": { "required": ["lines[]"], "optional": ["lang js|py|sh|json", "title", "theme light|dark", "size (>= 26)"] },
      "timing": { "min": 4, "ideal": 8, "max": 20 }, "ratios": ["16:9", "9:16 (short lines)"], "assets": ["real code from the project"], "fallback": "card", "preview": "previews/code_diff.jpg",
      "rule": "real code only; at most ~10 visible lines; highlight the line being talked about; calls in time order" },
    "terminal": { "version": "1.0.0", "file": "code.js", "call": "HF.terminal(K, layer, {...}) then .cmd/.out/.spinner", "explains": ["code", "instruction", "proof"],
      "inputs": { "required": ["commands"], "optional": ["title", "prompt", "size"] }, "timing": { "min": 3, "ideal": 6, "max": 15 }, "ratios": ["16:9", "9:16"],
      "assets": ["real commands and real output"], "fallback": "code", "preview": "previews/terminal.jpg", "rule": "never invent output: numbers come from real runs" },
    "stickman": { "version": "1.0.0", "file": "../stickman/stickman.js", "call": "Stickman.create(svg, {...}) ... (K.finish drives it)", "explains": ["story", "analogy", "process"],
      "inputs": { "required": ["an action (pose keys) per beat"], "optional": ["props", "emotes"] }, "timing": { "min": 2, "ideal": 3.5, "max": 5 }, "ratios": ["16:9", "9:16"],
      "assets": [], "fallback": "words", "preview": "previews/stickman.jpg", "rule": "2-4 moments per video, never back to back, never a whole video (kit/stickman/README.md)" }
  }
}
